#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
DIRECT_DART="$ROOT_DIR/tools/flutter-sdk-linux/bin/cache/dart-sdk/bin/dart"
SDK_PATH=""

TOOLING_HOME="$ROOT_DIR/.tooling/home"
TOOLING_CACHE="$ROOT_DIR/.tooling/cache"
TOOLING_CONFIG="$ROOT_DIR/.tooling/config"
PUB_CACHE_DIR="${PUB_CACHE:-$ROOT_DIR/.tooling/pub-cache}"

mkdir -p "$TOOLING_HOME" "$TOOLING_CACHE" "$TOOLING_CONFIG" "$PUB_CACHE_DIR"

export HOME="$TOOLING_HOME"
export XDG_CACHE_HOME="$TOOLING_CACHE"
export XDG_CONFIG_HOME="$TOOLING_CONFIG"
export PUB_CACHE="$PUB_CACHE_DIR"
export DART_SUPPRESS_ANALYTICS="true"

if [[ -x "$DIRECT_DART" ]]; then
  exec "$DIRECT_DART" "$@"
fi

SDK_PATH="$("$ROOT_DIR/scripts/bootstrap_flutter_toolchain.sh" --print-path)"
exec "$SDK_PATH/bin/cache/dart-sdk/bin/dart" "$@"
